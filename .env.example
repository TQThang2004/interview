# Sao chép file này thành .env và điền các giá trị thực tế
# cp .env.example .env

# --- Google Gemini API ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_KEY_EMBEDDING=your_embedding_key_or_leave_same
GOOGLE_API_KEY_TRANSLATE=your_translate_key_or_leave_same
GOOGLE_API_KEY_EXTRACT_TOPIC=your_extract_key_or_leave_same
GOOGLE_API_KEY_GENERATE_Q=your_generate_key_or_leave_same
GOOGLE_API_KEY_EVALUATE=your_evaluate_key_or_leave_same

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=ai_mock_interview_db

# --- JWT (dùng chuỗi ngẫu nhiên dài, bí mật) ---
JWT_SECRET_KEY=your_super_secret_jwt_key_here
COOKIE_SECURE=false

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- SMTP Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

